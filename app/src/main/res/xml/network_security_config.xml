<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!--
        Self-hosted Vikunja servers are often reached over plain http on a home network or a VPN,
        so cleartext has to stay allowed for whatever address the user enters. The setup screen
        warns when an http address points outside the local network (see ServerUrlSecurity).
    -->
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration,AcceptsUserCertificates">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
